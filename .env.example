CONTAINER_NAME=pi-web
IMAGE_TAG=latest
SERVER_PORT=30141

# The username is always "pi". Use a long random password when exposing Pi Web.
PI_WEB_PASSWORD=

# Comma-separated proxy or custom hostnames, for example pi-web.example.com.
PI_WEB_ALLOWED_HOSTS=

# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1
